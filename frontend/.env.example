# Backend API origin (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Active tenant business slug (must match Business.businessSlug in MongoDB)
NEXT_PUBLIC_BUSINESS_SLUG=bilal-electronics

# Canonical public site URL used for metadata, sitemap, robots, structured data
# Production must be HTTPS, e.g. https://www.example.com
NEXT_PUBLIC_SITE_URL=https://example.com
