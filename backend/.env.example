# Application
NODE_ENV=development
PORT=5000

# MongoDB — production MUST be a replica set or sharded cluster (transactions required)
MONGODB_URI=mongodb://localhost:27017/installment_platform

# 64-character hex recommended (min 32). Used for session secrets, OTP hashing, MFA, analytics.
APP_ENCRYPTION_KEY=replace-with-64-hex-character-key

# Comma-separated explicit origins only. Never use *.
# Production example: https://www.example.com,https://example.com
CORS_ORIGIN=http://localhost:3000

# Set true only when behind a trusted reverse proxy that sets X-Forwarded-* correctly.
TRUST_PROXY=false

# Optional analytics geo (only behind trusted proxy)
ANALYTICS_GEO_HEADERS=false
ANALYTICS_GEO_PROVIDER=

# Persistent media — required when NODE_ENV=production
MEDIA_BUCKET=your-media-bucket
MEDIA_REGION=us-east-1
MEDIA_ACCESS_KEY_ID=replace-with-storage-access-key
MEDIA_SECRET_ACCESS_KEY=replace-with-storage-secret
# Must be HTTPS in production (CDN or public bucket URL)
MEDIA_PUBLIC_BASE_URL=https://cdn.example.com
# Optional S3-compatible endpoint (R2, MinIO, etc.)
MEDIA_ENDPOINT=
MEDIA_FORCE_PATH_STYLE=false
